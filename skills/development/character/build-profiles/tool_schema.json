{
  "type": "function",
  "function": {
    "name": "build_profiles",
    "description": "生成短剧人物小传和关系网。用户要做人设或角色时调用。",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characters": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["name", "role", "want", "wound", "trait"],
            "properties": {
              "name": {"type": "string"},
              "role": {"type": "string", "description": "role_types 中的身份"},
              "want": {"type": "string"},
              "wound": {"type": "string"},
              "trait": {"type": "string"}
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["characters", "relationships"]
    }
  }
}
