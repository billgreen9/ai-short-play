{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["characters", "relationships", "markdown"],
  "properties": {
    "characters": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "role", "want", "wound", "trait"],
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string"},
          "want": {"type": "string"},
          "wound": {"type": "string"},
          "trait": {"type": "string"}
        }
      }
    },
    "relationships": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "string", "enum": ["llm", "template"]},
    "markdown": {"type": "string"}
  }
}
