{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["episodes", "markdown"],
  "properties": {
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["episode", "title", "conflict", "hook"],
        "properties": {
          "episode": {"type": "integer"},
          "title": {"type": "string"},
          "beat": {"type": "string"},
          "conflict": {"type": "string"},
          "hook": {"type": "string"}
        }
      }
    },
    "source": {"type": "string", "enum": ["llm", "template"]},
    "markdown": {"type": "string"}
  }
}
