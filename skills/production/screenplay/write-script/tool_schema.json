{
  "type": "function",
  "function": {
    "name": "write_script",
    "description": "按大纲写短剧台本，含场景、台词、运镜和转场。用户要写剧本或分镜台词时调用。",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "episodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["episode", "shots"],
            "properties": {
              "episode": {"type": "integer"},
              "shots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["scene", "camera_move", "transition", "duration_sec", "action", "dialogue"],
                  "properties": {
                    "scene": {"type": "string"},
                    "camera_move": {"type": "string"},
                    "transition": {"type": "string"},
                    "duration_sec": {"type": "number", "minimum": 1, "maximum": 8},
                    "action": {"type": "string"},
                    "dialogue": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      },
      "required": ["episodes"]
    }
  }
}
