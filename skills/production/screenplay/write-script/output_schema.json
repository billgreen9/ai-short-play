{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["episodes", "markdown"],
  "properties": {
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["episode", "shots"],
        "properties": {
          "episode": {"type": "integer"},
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["scene", "camera_move", "transition", "duration_sec", "action", "dialogue"],
              "properties": {
                "scene": {"type": "string"},
                "camera_move": {"type": "string"},
                "transition": {"type": "string"},
                "duration_sec": {"type": "number"},
                "action": {"type": "string"},
                "dialogue": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "source": {"type": "string", "enum": ["llm", "template"]},
    "markdown": {"type": "string"}
  }
}
