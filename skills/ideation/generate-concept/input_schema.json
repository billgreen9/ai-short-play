{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["user_input"],
  "properties": {
    "user_input": {"type": "string", "minLength": 1},
    "artifacts": {"type": "object"},
    "title": {"type": "string"},
    "genre": {"type": "string"},
    "logline": {"type": "string"},
    "hook": {"type": "string"},
    "episode_count": {"type": "integer", "minimum": 6, "maximum": 12},
    "core_conflict": {"type": "string"}
  }
}
